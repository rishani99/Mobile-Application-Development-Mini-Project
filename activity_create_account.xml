<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blueg"
    tools:context=".CreateAccountActivity">

    <EditText
        android:id="@+id/email"
        android:layout_width="224dp"
        android:layout_height="71dp"
        android:ems="10"
        android:inputType="text"
        android:textColor="#FAF6F6"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.844"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.499"
        tools:ignore="Autofill,DuplicateIds,LabelFor,SpeakableTextPresentCheck,TextFields" />

    <EditText
        android:id="@+id/pwd"
        android:layout_width="195dp"
        android:layout_height="66dp"
        android:ems="10"
        android:inputType="text"
        android:textColor="#FAF6F6"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.661"
        tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck,TextFields" />

    <TextView
        android:id="@+id/password"
        android:layout_width="166dp"
        android:layout_height="44dp"
        android:text="Passowrd"
        android:textColor="#F6F4F4"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.067"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.641"
        tools:ignore="HardcodedText,TextSizeCheck" />

    <EditText
        android:id="@+id/name"
        android:layout_width="240dp"
        android:layout_height="64dp"
        android:ems="10"
        android:inputType="text"
        android:textColor="#FAF6F6"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.885"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.357"
        tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck,TextFields" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="277dp"
        android:layout_height="64dp"
        android:text="Create Account"
        android:textAlignment="center"
        android:textColor="#FFFBFB"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.151"
        tools:ignore="HardcodedText,TextSizeCheck" />

    <TextView
        android:id="@+id/addname"
        android:layout_width="114dp"
        android:layout_height="52dp"
        android:text="Name"
        android:textColor="#F6F4F4"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.048"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.37"
        tools:ignore="HardcodedText,TextSizeCheck" />

    <TextView
        android:id="@+id/addemail"
        android:layout_width="130dp"
        android:layout_height="55dp"
        android:text="E-mail"
        android:textColor="#F6F4F4"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.056"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText,TextSizeCheck" />

    <Button
        android:id="@+id/signupbtn"
        android:layout_width="161dp"
        android:layout_height="64dp"
        android:backgroundTint="@android:color/darker_gray"
        android:text="Sign Up"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.544"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.827"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>